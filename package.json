{
  "name": "bazza-ui",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:up": "turbo run dev test:watch",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "bench": "turbo run bench",
    "bench:watch": "turbo run bench:watch",
    "type-check": "turbo run type-check",
    "clean": "zsh -c 'setopt nullglob && rm -rf **/node_modules **/dist **/.turbo **/.next **/.next-dev'",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "vercel:install": "turbo run vercel:install",
    "sgrep:watch": "sgrep watch .",
    "build": "turbo run build",
    "registry:build": "turbo run registry:build",
    "docs:type-gen": "turbo run type-gen --filter web",
    "start": "turbo run start",
    "start:portless": "turbo run start:portless",
    "prepare": "husky",
    "changeset": "changeset add",
    "ci:version": "changeset version && bun install",
    "ci:publish": "for dir in packages/*; do (cd \"$dir\" && bun publish || true); done && changeset tag",
    "ci:publish:canary": "for dir in packages/*; do (cd \"$dir\" && bun publish --tag canary || true); done && changeset tag"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@types/node": "^22",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "repomix": "^1.2.1",
    "turbo": "^2.4.4",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "apps/web/registry/ui/*",
    "apps/web/registry/components/*"
  ],
  "trustedDependencies": [
    "@biomejs/biome",
    "@repo/web",
    "@swc/core"
  ]
}

{
  "name": "@bazza-ui/loaders",
  "version": "0.1.0-canary.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./query": {
      "types": "./dist/adapters/query.d.ts",
      "import": "./dist/adapters/query.js",
      "require": "./dist/adapters/query.cjs"
    },
    "./swr": {
      "types": "./dist/adapters/swr.d.ts",
      "import": "./dist/adapters/swr.js",
      "require": "./dist/adapters/swr.cjs"
    },
    "./apollo": {
      "types": "./dist/adapters/apollo.d.ts",
      "import": "./dist/adapters/apollo.js",
      "require": "./dist/adapters/apollo.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "build": "tsup",
    "test": "vitest run --run --mode test",
    "test:watch": "vitest --mode test --watch --disable-console-intercept",
    "test:coverage": "vitest run --coverage --mode test"
  },
  "devDependencies": {
    "@apollo/client": "^3.11.11",
    "@bazza-ui/typescript-config": "workspace:*",
    "@tanstack/react-query": "^5.62.14",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitest/ui": "4.0.8",
    "swr": "^2.2.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "swr": {
      "optional": true
    },
    "@apollo/client": {
      "optional": true
    }
  }
}

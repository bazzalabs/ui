{
  "name": "@bazza-ui/react",
  "version": "0.1.0-canary.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./internal/listbox": {
      "types": "./dist/internal/listbox/index.d.ts",
      "import": "./dist/internal/listbox/index.js",
      "require": "./dist/internal/listbox/index.cjs"
    },
    "./internal/popup-menu": {
      "types": "./dist/internal/popup-menu/index.d.ts",
      "import": "./dist/internal/popup-menu/index.js",
      "require": "./dist/internal/popup-menu/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@base-ui/utils": "^0.2.3"
  },
  "devDependencies": {
    "@bazza-ui/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // oxlint lints how parts in `packages/react` are written, and keeps
  // `packages/menu-core` free of React and Base UI. Biome owns
  // formatting and general linting, so oxlint's categories are off and only
  // the rules named below run: the `bazza/*` rules in `tooling/lint`, plus
  // built-ins Biome has no active equivalent for.
  //
  // Run with --disable-nested-config (see package.json): a nested config would
  // otherwise replace these rules for its subtree without saying so.
  // Conventions and how to write an exception: "Lint" in packages/react/AGENTS.md.
  "plugins": ["react"],
  "categories": { "correctness": "off" },
  "jsPlugins": ["./tooling/lint/bazza-plugin.mjs"],
  "options": {
    // Only `oxlint-disable` counts as an exception. `bazza/disable-needs-reason`
    // reports any `eslint-disable` comment.
    "respectEslintDisableDirectives": false,
    "denyWarnings": true
  },
  "ignorePatterns": ["**/node_modules/**", "**/dist/**"],
  "overrides": [
    {
      // Correctness rules: source and tests.
      "files": ["packages/react/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
      "rules": {
        "react-hooks/rules-of-hooks": "error",
        "bazza/disable-needs-reason": "error",
        "bazza/resolve-state-props": "error",
        "bazza/no-spread-style": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@base-ui/react/internals/**"],
                "message": "Base UI's `internals` are private and can change in any release. Use a public `@base-ui/react/<component>` or `@base-ui/utils/<helper>` export, or copy what you need into `src/utils`. See \"Lint\" in packages/react/AGENTS.md."
              },
              {
                "group": ["@base-ui-components/**"],
                "message": "`@base-ui-components/*` is the old package name. Import from `@base-ui/react` or `@base-ui/utils`. See \"Lint\" in packages/react/AGENTS.md."
              }
            ]
          }
        ]
      }
    },
    {
      // Part-authoring rules: shipped source only. Tests define throwaway
      // components and contexts that don't need to follow them.
      "files": ["packages/react/src/**/*.{ts,tsx}"],
      "rules": {
        "bazza/context-hook-contract": "error",
        "bazza/forward-ref-named": "error",
        "bazza/part-namespace": "error"
      }
    },
    {
      // Writes of a store's controlled state, in shipped source and tests.
      "files": ["packages/react/src/**/*.{ts,tsx}"],
      "rules": { "bazza/no-raw-controlled-state": "error" }
    },
    {
      "files": [
        "packages/react/src/**/*.tsx",
        "packages/react/src/**/*-context.ts"
      ],
      "rules": { "bazza/use-client": "error" }
    },
    {
      "files": [
        "packages/react/src/**/*.data-attrs.ts",
        "packages/react/src/**/*.data-attributes.ts",
        "packages/react/src/**/*.css-vars.ts"
      ],
      "rules": { "bazza/data-attrs-enum": "error" }
    },
    // --- Layers ------------------------------------------------------------------
    // Which parts of `src` may import which: "Layers" in packages/react/AGENTS.md.
    // An override's `no-restricted-imports` replaces the options of earlier ones
    // for its files, so each one repeats the Base UI patterns above.
    {
      // menu-core: the bottom layer, below all of packages/react. No React, no
      // Base UI, nothing from packages/react. Its tests follow the same rule.
      "files": ["packages/menu-core/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
      "rules": {
        "bazza/disable-needs-reason": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react/**", "react-dom", "react-dom/**"],
                "message": "`@bazza-ui/menu-core` is framework-free: it never imports React. Keep the React part in packages/react and give menu-core a plain callback or value. See \"Layers\" in packages/react/AGENTS.md."
              },
              {
                "group": ["@base-ui/**", "@base-ui-components/**"],
                "message": "`@bazza-ui/menu-core` never imports Base UI. Keep the Base UI part in packages/react. See \"Layers\" in packages/react/AGENTS.md."
              },
              {
                "group": [
                  "@bazza-ui/react",
                  "@bazza-ui/react/**",
                  "**/react/src/**"
                ],
                "message": "`@bazza-ui/menu-core` is the bottom layer: it imports nothing from packages/react. Move what both need into menu-core. See \"Layers\" in packages/react/AGENTS.md."
              }
            ]
          }
        ]
      }
    },
    {
      // utils: imports nothing else in src.
      "files": ["packages/react/src/utils/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@base-ui/react/internals/**"],
                "message": "Base UI's `internals` are private and can change in any release. Use a public `@base-ui/react/<component>` or `@base-ui/utils/<helper>` export, or copy what you need into `src/utils`. See \"Lint\" in packages/react/AGENTS.md."
              },
              {
                "group": ["@base-ui-components/**"],
                "message": "`@base-ui-components/*` is the old package name. Import from `@base-ui/react` or `@base-ui/utils`. See \"Lint\" in packages/react/AGENTS.md."
              },
              {
                "group": [
                  "**/internal/**",
                  "**/dropdown-menu/**",
                  "**/context-menu/**",
                  "**/command-menu/**",
                  "**/suggestion-menu/**",
                  "**/select/**",
                  "**/combobox/**",
                  "**/loaders/**",
                  "**/kbd/**",
                  "**/video-player/**"
                ],
                "message": "`src/utils` is the bottom layer: it imports nothing else in `src`. Move what both sides need into `src/utils`. See \"Layers\" in packages/react/AGENTS.md."
              }
            ]
          }
        ]
      }
    },
    {
      // The engine (every folder under internal, popup-menu included): never a
      // member, loader or family. The stricter listbox override below replaces
      // this for its files.
      "files": ["packages/react/src/internal/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@base-ui/react/internals/**"],
                "message": "Base UI's `internals` are private and can change in any release. Use a public `@base-ui/react/<component>` or `@base-ui/utils/<helper>` export, or copy what you need into `src/utils`. See \"Lint\" in packages/react/AGENTS.md."
              },
              {
                "group": ["@base-ui-components/**"],
                "message": "`@base-ui-components/*` is the old package name. Import from `@base-ui/react` or `@base-ui/utils`. See \"Lint\" in packages/react/AGENTS.md."
              },
              {
                "group": [
                  "**/dropdown-menu/**",
                  "**/context-menu/**",
                  "**/command-menu/**",
                  "**/suggestion-menu/**",
                  "**/select/**",
                  "**/combobox/**",
                  "**/loaders/**",
                  "**/kbd/**",
                  "**/video-player/**"
                ],
                "message": "The engine (`src/internal`) never imports a member, a loader, `kbd` or `video-player`. Give the engine a generic option the member sets (like `externalFocus` on the popup-menu context), or move the shared code into `src/utils`. See \"Layers\" in packages/react/AGENTS.md."
              }
            ]
          }
        ]
      }
    },
    {
      // internal/listbox: utils only.
      "files": ["packages/react/src/internal/listbox/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@base-ui/react/internals/**"],
                "message": "Base UI's `internals` are private and can change in any release. Use a public `@base-ui/react/<component>` or `@base-ui/utils/<helper>` export, or copy what you need into `src/utils`. See \"Lint\" in packages/react/AGENTS.md."
              },
              {
                "group": ["@base-ui-components/**"],
                "message": "`@base-ui-components/*` is the old package name. Import from `@base-ui/react` or `@base-ui/utils`. See \"Lint\" in packages/react/AGENTS.md."
              },
              {
                "group": ["**/popup-menu/**"],
                "message": "`internal/listbox` sits below `internal/popup-menu` and never imports it. Move what both need into `internal/listbox` (popup-menu can re-export it) or `src/utils`. See \"Layers\" in packages/react/AGENTS.md."
              },
              {
                "group": [
                  "**/dropdown-menu/**",
                  "**/context-menu/**",
                  "**/command-menu/**",
                  "**/suggestion-menu/**",
                  "**/select/**",
                  "**/combobox/**",
                  "**/loaders/**",
                  "**/kbd/**",
                  "**/video-player/**"
                ],
                "message": "The engine (`src/internal`) never imports a member, a loader, `kbd` or `video-player`. Give the engine a generic option the member sets (like `externalFocus` on the popup-menu context), or move the shared code into `src/utils`. See \"Layers\" in packages/react/AGENTS.md."
              }
            ]
          }
        ]
      }
    },
    {
      // Members and loaders: the engine through its index (or members.ts), utils,
      // and other families through their index.
      "files": [
        "packages/react/src/{dropdown-menu,context-menu,command-menu,suggestion-menu,select,combobox,loaders}/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@base-ui/react/internals/**"],
                "message": "Base UI's `internals` are private and can change in any release. Use a public `@base-ui/react/<component>` or `@base-ui/utils/<helper>` export, or copy what you need into `src/utils`. See \"Lint\" in packages/react/AGENTS.md."
              },
              {
                "group": ["@base-ui-components/**"],
                "message": "`@base-ui-components/*` is the old package name. Import from `@base-ui/react` or `@base-ui/utils`. See \"Lint\" in packages/react/AGENTS.md."
              },
              {
                "group": [
                  "**/internal/**",
                  "!**/internal/popup-menu/index.js",
                  "!**/internal/popup-menu/members.js",
                  "!**/internal/listbox/index.js"
                ],
                "message": "Members and loaders import the engine only through `internal/popup-menu/index.js`, `internal/popup-menu/members.js` or `internal/listbox/index.js`. For a name `index.js` doesn't export, add it to `members.ts`. See \"Layers\" in packages/react/AGENTS.md."
              },
              {
                "group": [
                  "**/dropdown-menu/**",
                  "**/context-menu/**",
                  "**/command-menu/**",
                  "**/suggestion-menu/**",
                  "**/select/**",
                  "**/combobox/**",
                  "**/loaders/**"
                ],
                "message": "Nothing imports a member or a loader: they are the top layer. Move what both need into the engine or `src/utils`. See \"Layers\" in packages/react/AGENTS.md."
              },
              {
                "group": [
                  "**/kbd/**",
                  "**/video-player/**",
                  "!**/kbd/index.js",
                  "!**/video-player/index.js"
                ],
                "message": "Import another family only through its `index.js`, or move what both need into `src/utils` (as `use-hotkey` lives in `src/utils/keybinding`). See \"Layers\" in packages/react/AGENTS.md."
              }
            ]
          }
        ]
      }
    },
    {
      // Independent families: utils and other families' index.
      "files": ["packages/react/src/{kbd,video-player}/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@base-ui/react/internals/**"],
                "message": "Base UI's `internals` are private and can change in any release. Use a public `@base-ui/react/<component>` or `@base-ui/utils/<helper>` export, or copy what you need into `src/utils`. See \"Lint\" in packages/react/AGENTS.md."
              },
              {
                "group": ["@base-ui-components/**"],
                "message": "`@base-ui-components/*` is the old package name. Import from `@base-ui/react` or `@base-ui/utils`. See \"Lint\" in packages/react/AGENTS.md."
              },
              {
                "group": [
                  "**/internal/**",
                  "**/dropdown-menu/**",
                  "**/context-menu/**",
                  "**/command-menu/**",
                  "**/suggestion-menu/**",
                  "**/select/**",
                  "**/combobox/**",
                  "**/loaders/**"
                ],
                "message": "`kbd` and `video-player` are independent families: they import `src/utils` and other families' `index.js` only. See \"Layers\" in packages/react/AGENTS.md."
              },
              {
                "group": [
                  "**/kbd/**",
                  "**/video-player/**",
                  "!**/kbd/index.js",
                  "!**/video-player/index.js"
                ],
                "message": "Import another family only through its `index.js`, or move what both need into `src/utils`. See \"Layers\" in packages/react/AGENTS.md."
              }
            ]
          }
        ]
      }
    },
    {
      // Tests may import any layer: back to the Base UI patterns alone.
      "files": ["packages/react/src/**/*.test.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@base-ui/react/internals/**"],
                "message": "Base UI's `internals` are private and can change in any release. Use a public `@base-ui/react/<component>` or `@base-ui/utils/<helper>` export, or copy what you need into `src/utils`. See \"Lint\" in packages/react/AGENTS.md."
              },
              {
                "group": ["@base-ui-components/**"],
                "message": "`@base-ui-components/*` is the old package name. Import from `@base-ui/react` or `@base-ui/utils`. See \"Lint\" in packages/react/AGENTS.md."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/react/src/**/*.test.{ts,tsx}"],
      "rules": {
        "bazza/context-hook-contract": "off",
        "bazza/forward-ref-named": "off",
        "bazza/part-namespace": "off",
        "bazza/use-client": "off"
      }
    },

    // --- Allowlists -----------------------------------------------------------
    // Files that broke a rule when the rule was added. Each file is exempt from
    // that one rule until it's fixed. Shrink these lists: fix the file, then
    // delete its line. Never add a file here to get a new change through; use a
    // reasoned `oxlint-disable-next-line` instead.

    {
      // `as const` objects the docs can't read. Convert each to an enum.
      "files": [
        "packages/react/src/combobox/clear/clear.data-attrs.ts",
        "packages/react/src/combobox/icon/icon.data-attrs.ts",
        "packages/react/src/combobox/input-wrapper/input-wrapper.data-attrs.ts",
        "packages/react/src/combobox/input/input.data-attrs.ts",
        "packages/react/src/combobox/item-indicator/item-indicator.data-attrs.ts",
        "packages/react/src/combobox/item-label/item-label.data-attrs.ts",
        "packages/react/src/combobox/item/item.data-attrs.ts",
        "packages/react/src/combobox/positioner/positioner.data-attrs.ts",
        "packages/react/src/combobox/scroll-arrow/scroll-arrow.data-attrs.ts",
        "packages/react/src/combobox/surface/surface.data-attrs.ts",
        "packages/react/src/context-menu/icon/icon.data-attrs.ts",
        "packages/react/src/context-menu/scroll-arrow/scroll-arrow.data-attrs.ts",
        "packages/react/src/dropdown-menu/icon/icon.data-attrs.ts",
        "packages/react/src/dropdown-menu/scroll-arrow/scroll-arrow.data-attrs.ts",
        "packages/react/src/internal/popup-menu/components/icon/icon.data-attrs.ts",
        "packages/react/src/internal/popup-menu/components/scroll-arrow/scroll-arrow.data-attrs.ts",
        "packages/react/src/select/icon/icon.data-attrs.ts",
        "packages/react/src/select/item-indicator/item-indicator.data-attrs.ts",
        "packages/react/src/select/item-label/item-label.data-attrs.ts",
        "packages/react/src/select/item/item.data-attrs.ts",
        "packages/react/src/select/positioner/positioner.data-attrs.ts",
        "packages/react/src/select/scroll-arrow/scroll-arrow.data-attrs.ts",
        "packages/react/src/select/surface/surface.data-attrs.ts",
        "packages/react/src/select/trigger/trigger.data-attrs.ts",
        "packages/react/src/select/value/value.data-attrs.ts"
      ],
      "rules": { "bazza/data-attrs-enum": "off" }
    },
    {
      // Exported parts with no namespace of their own.
      "files": [
        "packages/react/src/internal/popup-menu/components/list/list.tsx",
        "packages/react/src/internal/popup-menu/data-first/data-list.tsx",
        "packages/react/src/video-player/components/captions-menu/captions-menu.tsx",
        "packages/react/src/video-player/components/playback-rate-menu/playback-rate-menu.tsx",
        "packages/react/src/video-player/components/quality-menu/quality-menu.tsx",
        "packages/react/src/video-player/components/seek-slider/seek-slider.tsx",
        "packages/react/src/video-player/components/volume-slider/volume-slider.tsx"
      ],
      "rules": { "bazza/part-namespace": "off" }
    },
    {
      // Context modules without `'use client'`.
      "files": [
        "packages/react/src/combobox/input-wrapper/input-wrapper-context.ts",
        "packages/react/src/internal/popup-menu/contexts/graft-point-context.ts"
      ],
      "rules": { "bazza/use-client": "off" }
    },
    {
      // Spread a `style` prop. The video player's are typed as objects today.
      "files": [
        "packages/react/src/combobox/positioner/positioner.tsx",
        "packages/react/src/internal/popup-menu/components/positioner/positioner.tsx",
        "packages/react/src/video-player/components/buffered-indicator/buffered-indicator.tsx",
        "packages/react/src/video-player/components/seek-slider/seek-slider.tsx",
        "packages/react/src/video-player/components/time-display/time-display.tsx"
      ],
      "rules": { "bazza/no-spread-style": "off" }
    },
    {
      // `use*` context hooks that can return null. Throw, or rename to `useMaybe*`.
      "files": [
        "packages/react/src/combobox/contexts/combobox-positioner-context.ts",
        "packages/react/src/internal/listbox/contexts/group-context.ts",
        "packages/react/src/internal/popup-menu/contexts/graft-point-context.ts",
        "packages/react/src/internal/popup-menu/contexts/popup-surface-id-context.ts",
        "packages/react/src/internal/popup-menu/data-first/async-coordinator.tsx",
        "packages/react/src/select/contexts/select-positioner-context.ts"
      ],
      "rules": { "bazza/context-hook-contract": "off" }
    },
    {
      // A class method calls `useRefWithInit`.
      "files": ["packages/react/src/internal/listbox/store/ListboxStore.ts"],
      "rules": { "react-hooks/rules-of-hooks": "off" }
    },
    {
      // Imports `useDirection` from Base UI's internals.
      "files": ["packages/react/src/select/positioner/positioner.tsx"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      // A stale `eslint-disable-line` comment.
      "files": [
        "packages/react/src/internal/popup-menu/data-first/data-list.tsx"
      ],
      "rules": { "bazza/disable-needs-reason": "off" }
    }
  ]
}
